# Copy to .env (chipnet) or .env.mainnet. `npm run shop -- keygen` fills in MERCHANT_WIF.
# Only VITE_ values reach the browser; the deployed site has no backend and never sees the key.
NETWORK=chipnet                 # chipnet | mainnet
MERCHANT_WIF=                   # owns the demo shop, receives protocol fees, funds test wallets
SATS_PER_STAMP_EARNED=1000      # demo shop: customer earns 1 stamp per this many sats
SATS_PER_STAMP=30               # demo shop: reserve pays this many sats per stamp (3% back)

VITE_NETWORK=chipnet
VITE_FEE_PER_STAMP=10           # protocol fee per stamp issued (1% at 1,000 sats per stamp)
VITE_PROTOCOL_PKH=              # filled in by keygen: hash of the protocol treasury key
VITE_DEMO_SHOP=                 # filled in by `shop open`: the shop featured on the home page
VITE_DECK_URL=
VITE_REPO_URL=
VITE_DONATION_ADDRESS=

# Nostr key for the demo shop identity (written by `shop identity`, never printed)
NOSTR_SECRET_HEX=
VITE_START_DEMO_URL=
VITE_START_CODE_URL=
