# Copy to .env. `npm run setup -w server -- keygen` fills in MERCHANT_WIF for you.
NETWORK=chipnet                 # chipnet | mainnet
MERCHANT_WIF=                   # hot key: receives payments, holds stamp supply. Keep balances small.
STAMP_CATEGORY=                 # filled in by `setup mint`
SATS_PER_STAMP_EARNED=1000      # customer earns 1 stamp per this many sats paid
SATS_PER_STAMP=30               # reserve pays this many sats per stamp redeemed (3% back at the defaults)
POLL_SECONDS=4

# Web app (public values only, baked in at build time)
VITE_NETWORK=chipnet
VITE_MERCHANT_NAME=Demo Café
VITE_MERCHANT_ADDRESS=
VITE_MERCHANT_PKH=
VITE_STAMP_CATEGORY=
VITE_SATS_PER_STAMP_EARNED=1000
VITE_SATS_PER_STAMP=30
VITE_DECK_URL=
VITE_REPO_URL=
VITE_DONATION_ADDRESS=
